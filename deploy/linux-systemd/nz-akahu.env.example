# Copy to /opt/nz-akahu-mcp/nz-akahu.env and restrict permissions to the
# service account or root. Do not commit real values.

AKAHU_APP_TOKEN=<TOKEN>
AKAHU_USER_TOKEN=<TOKEN>
AKAHU_READ_ONLY=true
AKAHU_AUTOMATION_BYPASS=false
AKAHU_REQUEST_TIMEOUT=10
AKAHU_LOG_LEVEL=INFO

# Keep the MCP HTTP listener on loopback and put HTTPS in front of it.
NZ_AKAHU_MCP_HTTP_HOST=127.0.0.1
NZ_AKAHU_MCP_HTTP_PORT=8091
NZ_AKAHU_MCP_HTTP_PATH=/mcp

# Bearer mode.
NZ_AKAHU_MCP_AUTH_MODE=bearer
NZ_AKAHU_MCP_BEARER_TOKEN=<TOKEN>

# OAuth mode alternative. Uncomment these values and set
# NZ_AKAHU_MCP_AUTH_MODE=oauth when using an allowlisted Google OAuth connector.
# NZ_AKAHU_MCP_GOOGLE_CLIENT_ID=<CLIENT_ID>
# NZ_AKAHU_MCP_GOOGLE_CLIENT_SECRET=<CLIENT_SECRET>
# NZ_AKAHU_MCP_PUBLIC_BASE_URL=https://mcp.example.com
# NZ_AKAHU_MCP_ALLOWED_USERS=you@example.com
# NZ_AKAHU_MCP_ALLOWED_DOMAINS=example.com
