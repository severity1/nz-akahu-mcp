# Akahu credentials. Get yours from https://my.akahu.nz/developers
# Required: both tokens.
AKAHU_APP_TOKEN=app_token_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
AKAHU_USER_TOKEN=user_token_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Akahu API base URL. Almost never needs changing.
AKAHU_BASE_URL=https://api.akahu.io/v1

# SAFETY: read-only mode is on by default. Every write tool refuses with a
# clear error until you flip this to false.
AKAHU_READ_ONLY=true

# SAFETY: per-call elicitation bypass for the *automatable* subset of writes.
#
# What this does:
#   When AKAHU_READ_ONLY=false, every write tool asks Claude to confirm with
#   you before it fires (an "elicitation prompt"). Setting this flag to true
#   skips that prompt -- but only for tools whose decorator explicitly
#   declared automatable=True.
#
# Why a separate subset:
#   A write is only marked automatable=True if it satisfies ALL four:
#     1. Idempotent or naturally rate-limited
#     2. No third-party side effects (no humans notified, no money moved,
#        no identity records changed)
#     3. Easily reversed or self-corrects next cycle
#     4. Has a common automation use case (e.g. nightly refresh)
#
# Which tools that subset currently contains:
#   - accounts/refresh_all_accounts
#   - accounts/refresh_account
#
# Which tools are NOT bypassable and will ALWAYS elicit:
#   - transactions/report_transaction_issue (sends a ticket to Akahu staff)
#   - identity/verify_name (identity check, may incur per-call charge)
#
# Logging:
#   Every bypassed call logs at INFO with the tool name. On startup, the
#   server prints a banner enumerating the bypass-eligible tools so the
#   current safety posture is always visible.
#
# Recommendation:
#   Leave this false for ad-hoc Claude conversations. Only set true if you
#   are running an unattended automation that needs to call refresh on a
#   schedule.
AKAHU_AUTOMATION_BYPASS=false

# HTTP timeout for Akahu API calls (seconds).
AKAHU_REQUEST_TIMEOUT=10

# Log verbosity. DEBUG includes response bodies but never tokens.
AKAHU_LOG_LEVEL=INFO

# Streamable HTTP MCP ingress. Bearer mode is the default and requires clients
# to send Authorization: Bearer <TOKEN>.
NZ_AKAHU_MCP_AUTH_MODE=bearer
NZ_AKAHU_MCP_BEARER_TOKEN=<TOKEN>
NZ_AKAHU_MCP_HTTP_HOST=127.0.0.1
NZ_AKAHU_MCP_HTTP_PORT=8091
NZ_AKAHU_MCP_HTTP_PATH=/mcp

# OAuth mode is for public HTTPS web connectors. Google is only the upstream
# login provider; Akahu tokens stay in this server's runtime environment.
NZ_AKAHU_MCP_GOOGLE_CLIENT_ID=<CLIENT_ID>
NZ_AKAHU_MCP_GOOGLE_CLIENT_SECRET=<CLIENT_SECRET>
NZ_AKAHU_MCP_PUBLIC_BASE_URL=https://mcp.example.com/akahu-mcp
NZ_AKAHU_MCP_ALLOWED_USERS=you@example.com
NZ_AKAHU_MCP_ALLOWED_DOMAINS=example.com
